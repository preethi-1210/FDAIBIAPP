# Ryze Infinity API: production settings. provision.sh copies this to /opt/ryze/shared/backend.env
# (root:ryze, mode 640) and fills DATABASE_URL and JWT_SECRET with generated values. Replace every
# CHANGE_ME on the server itself (sudo nano /opt/ryze/shared/backend.env). Never commit the real file.
# Startup refuses to run if any production safety check fails (see backend/app/deployment.py).

ENVIRONMENT=production
DEMO_MODE=false
LOG_FORMAT=json

# PostgreSQL on this server, restricted (non-superuser) application role.
DATABASE_URL=__DATABASE_URL__

# Session signing key (generated; at least 32 characters).
JWT_SECRET=__JWT_SECRET__

# Public addresses. The browser reaches the API at /api through Caddy.
FRONTEND_URL=https://www.ryzeaibiapp.com
CORS_ORIGINS=https://www.ryzeaibiapp.com

# Google sign-in. Add the redirect URI below to the OAuth client in Google Cloud Console.
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://www.ryzeaibiapp.com/api/auth/oidc/callback
OIDC_DISCOVERY_URL=https://accounts.google.com

# Databricks. Copy the catalog/schema mapping values exactly from the current backend/.env;
# do not change them.
WAREHOUSE=databricks
DATABRICKS_SERVER_HOSTNAME=CHANGE_ME
DATABRICKS_HTTP_PATH=CHANGE_ME
DATABRICKS_WAREHOUSE_ID=CHANGE_ME
DATABRICKS_TOKEN=CHANGE_ME
DATABRICKS_CATALOG=CHANGE_ME
DATABRICKS_SCHEMA=CHANGE_ME
DATABRICKS_DOMAIN_CATALOGS=CHANGE_ME
DATABRICKS_DOMAIN_SCHEMA=CHANGE_ME
DATABRICKS_HEALTHCARE_TENANT_CATALOGS=CHANGE_ME
LIVE_SIMULATE=false

# AI model provider.
LLM_PROVIDER=google
GOOGLE_API_KEY=CHANGE_ME
GOOGLE_MODEL=CHANGE_ME
# No Ollama on this server: an empty fallback disables it instead of failing over to nothing.
LLM_FALLBACK_PROVIDER=

# Writable data lives under /opt/ryze/shared, never inside a release.
CHROMA_DB_PATH=/opt/ryze/shared/data/chroma

# Shared cache stays off until Garnet passes validation; the API runs one worker meanwhile.
CACHE_URL=

# Optional: protects /metrics (which Caddy also keeps private). Leave empty to disable it.
METRICS_TOKEN=
