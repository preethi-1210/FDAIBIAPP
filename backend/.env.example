DEMO_USERNAME=admin
DEMO_PASSWORD=change-me-not-a-real-password
JWT_SECRET=ryze-dev-secret-change-me
# Optional OpenID Connect. Register the callback URL exactly as configured below.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8013/auth/oidc/callback
#OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://accounts.google.com
# Optional verified ID-token claim checked against the provisioned Healthcare tenant, e.g. tenant_id.
OIDC_TENANT_CLAIM=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002
DATABASE_URL=sqlite:///./ryze_bi.db
# Optional Redis-compatible Valkey cache. Empty disables shared caching.
CACHE_URL=
CACHE_TTL_SECONDS=120
# Local PostgreSQL option after `docker compose up -d`:
# DATABASE_URL=postgresql://ryze:ryze@localhost:5432/ryze_bi
# development, staging or production. Outside development the API refuses to start with
# DEMO_MODE on, a weak JWT_SECRET, plain HTTP addresses, mock payments, SQLite, a PostgreSQL
# superuser, or an account still on its demo password.
ENVIRONMENT=development
# Development only: allow non-loopback addresses (insecure cookies) for a trusted network demo.
ALLOW_INSECURE_DEVELOPMENT=false
# Seeds demo users and synthetic business data, and shows their passwords at sign-in.
# Development only.
DEMO_MODE=true
# DATABASE_URL=postgresql://ryze:ryze@localhost:5432/ryze_bi
LIVE_SIMULATE=false
SEED_CUSTOMERS_PER_DOMAIN=80

LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-2-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b
RAG_EMBEDDING_MODEL=nomic-embed-text
CHROMA_DB_PATH=.chroma
MCP_ACCESS_TOKEN=
# Auto prefers configured OpenAI/Grok credentials, then uses local Ollama.
# Examples: deepseek-r1:8b, gemma3:4b, mistral:7b

WAREHOUSE=local
# WAREHOUSE=databricks
# WAREHOUSE=snowflake
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=banking
DATABRICKS_SCHEMA=silver
DATABRICKS_DOMAIN_CATALOGS=banking:banking,insurance:insurance,retail:retail
# Add healthcare:<catalog> only after the healthcare source schema has been provisioned and verified.
DATABRICKS_DOMAIN_SCHEMA=silver
# Map each provisioned Healthcare tenant to its own isolated catalog.
DATABRICKS_HEALTHCARE_TENANT_CATALOGS=

# Alternate Databricks variable names are also accepted:
# DATABRICKS_HOST=
# WAREHOUSE_ID=
# DATABRICKS_PAT=
# DATABRICKS_HOST can be a bare workspace host; configure DATABRICKS_HTTP_PATH
# or set WAREHOUSE_ID so the backend can derive the SQL Warehouse HTTP path.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC


LLM_TIMEOUT_SECONDS=180
# Business users' prediction requests wait for administrator approval before TabPFN runs.
HITL_PREDICTION_REVIEW=true
# Used when the selected LLM provider fails (quota, invalid key, outage). Empty disables it.
LLM_FALLBACK_PROVIDER=ollama
LLM_MAX_CONCURRENCY=8

# Governed routing: metrics, definitions and application questions are answered by tools
# instead of generated SQL. Set false to return to the SQL-only workflow.
ASK_AI_AGENTIC_ROUTING=true
# Banking questions use the metric registry and forecasting workflow. false returns banking to the
# general path. BANKING_LLM_PLANNING=false leaves a question to rules, then asks for clarification.
BANKING_AGENT_ENABLED=true
BANKING_LLM_PLANNING=true
# Lets a model write SQL for questions outside the registry. Enable only for a model that has passed
# evals/run_sql_eval.py; validation cannot detect SQL that is valid but answers the wrong question.
BANKING_GENERATED_SQL=false
# Whole-request limit; a request past it returns 504. 0 disables it.
ASK_DEADLINE_SECONDS=300
# auto: TabPFN, then the statistical baseline if TabPFN cannot run. tabpfn: never fall back.
PREDICTION_ENGINE=auto
# Enforced by the warehouse on each statement. 0 leaves the warehouse default.
DATABRICKS_STATEMENT_TIMEOUT_SECONDS=120

# Per minute: questions per user, sign-ins per client IP (behind a proxy, all clients may share
# one IP). 0 disables. Shared through CACHE_URL when it is set.
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=20

# Approved-document retrieval: below this confidence the assistant says it cannot verify.
KNOWLEDGE_MIN_CONFIDENCE=0.5
KNOWLEDGE_STALE_AFTER_DAYS=365
# Cosine similarity for semantic matches, using RAG_EMBEDDING_MODEL. 0 means keyword search only.
KNOWLEDGE_MIN_SIMILARITY=0.62
# TabPFN stays off until a weight license is approved and the weights are on disk.
TABPFN_ENABLED=false
TABPFN_MODEL_PATH=
# MCP exposes approved tools only; true also exposes ask_business, which can run generated SQL.
MCP_ALLOW_GENERATED_SQL=false

# Days to keep conversations and query history; 0 keeps them. Applied by purge_history.py.
HISTORY_RETENTION_DAYS=0

# text or json
LOG_FORMAT=text
# Bearer token for a metrics scraper. Empty means /metrics requires an administrator.
METRICS_TOKEN=

# Subscription plans and AI allowances. A plan never grants access to a business domain.
# SUBSCRIPTIONS_ENABLED=false turns off the plans, limits and usage records.
SUBSCRIPTIONS_ENABLED=true
# false records usage but limits nobody.
SUBSCRIPTION_ENFORCEMENT=true
SUBSCRIPTION_NOTICE_THRESHOLDS=30,50,80,90,100
SUBSCRIPTION_CURRENCY=INR
# Empty: no online payment. mock moves no money and works only when DEMO_MODE=true.
PAYMENT_GATEWAY=
# provider:model=input,output per million tokens, separated by ;. Without a rate, cost shows as unknown.
LLM_COST_PER_MILLION_TOKENS=

# Approved metric registries for these domains answer first; see backend/app/services/domain_registries.py.
# Remove a domain to return it to the previous behaviour.
METRIC_REGISTRY_DOMAINS=finance,insurance,retail,healthcare
# false: questions those registries cannot represent are refused instead of going to model-written SQL.
REGISTRY_GENERATED_SQL=true
# Parsed table and column allowlists for model-written SQL (backend/app/sql_allowlists/).
# shadow logs what would be refused; enforce refuses it; off skips the check.
SQL_ALLOWLIST_MODE=shadow
